# ملف مثال فقط. انسخه إلى `.env` ثم عدّل القيم قبل التشغيل.
# لا تضع القيم الحقيقية داخل GitHub أو داخل المستودع.

# مطلوب: توكن البوت من @BotFather
# يدعم أيضاً الأسماء البديلة: BOT_TOKEN أو TELEGRAM_TOKEN
TELEGRAM_BOT_TOKEN=ضع_توكن_البوت_هنا

# اختياري: تفعيل ردود OpenAI الذكية
OPENAI_API_KEY=

# اختياري: موديل OpenAI المستخدم عند وجود المفتاح
# القيمة الافتراضية داخل الكود: gpt-4o-mini
OPENAI_MODEL=gpt-4o-mini

# اختياري: رقم معرف الأدمن الذي يستطيع استخدام /rename و /people
# الاسم البديل المدعوم: ADMIN_ID
BOT_ADMIN_ID=8561249287

# اختياري: ملف تخزين المستخدمين والمدفوعات محلياً
# الاسم البديل المدعوم: BOT_USER_STORE_FILE
USER_STORE_FILE=bot_users.json
